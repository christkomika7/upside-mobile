{
  "expo": {
    "name": "UPSide",
    "slug": "upside-mobile",
    ...
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00887F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UPSide accède à vos photos pour joindre des photos de dégâts et de devis aux interventions.",
          "cameraPermission": "UPSide utilise l'appareil photo pour prendre des photos des dégâts et des devis lors des interventions."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keep class com.google.android.gms.** { *; }"
          }
        }
      ]
    ]
  }
}
